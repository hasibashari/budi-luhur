# ==============================================================================
# BUDI LUHUR ECOSYSTEM — VERCEL ENVIRONMENT VARIABLES (NEON POSTGRESQL)
# Masukkan variabel-variabel ini ke Vercel Dashboard: Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION STRINGS (NEON POSTGRES)
# Rekomendasi: Gunakan Neon Pooled Connection String (yang memiliki '-pooler' pada host)
# Format: postgresql://[user]:[password]@[neon-host]-pooler.neon.tech/[dbname]?sslmode=require
# ------------------------------------------------------------------------------
APP1_DATABASE_URL="postgresql://neondb_owner:password@ep-app1-pooler.ap-southeast-1.aws.neon.tech/fe_tablet_app1?sslmode=require"
APP2_DATABASE_URL="postgresql://neondb_owner:password@ep-app2-pooler.ap-southeast-1.aws.neon.tech/fe_tablet_app2?sslmode=require"
APP3_DATABASE_URL="postgresql://neondb_owner:password@ep-app3-pooler.ap-southeast-1.aws.neon.tech/fe_tablet_app3?sslmode=require"

# ------------------------------------------------------------------------------
# 2. JWT SECRETS (Terisolasi per Aplikasi)
# ------------------------------------------------------------------------------
APP1_JWT_SECRET="femory_super_secret_jwt_key_prod_2026_xyz"
APP2_JWT_SECRET="pilluna_super_secret_jwt_key_prod_2026_xyz"
APP3_JWT_SECRET="preluna_super_secret_jwt_key_prod_2026_xyz"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. AI & INTEGRATION KEYS (Opsional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 4. ENVIRONMENT & SYSTEM
# ------------------------------------------------------------------------------
NODE_ENV="production"
DB_POOL_MAX="5"

# ------------------------------------------------------------------------------
# 5. FRONTEND PORTAL APP URLS (VERCEL DEPLOYMENT)
# ------------------------------------------------------------------------------
VITE_APP_1_URL="https://budi-luhur-app1.vercel.app"
VITE_APP_2_URL="https://budi-luhur-app2.vercel.app"
VITE_APP_3_URL="https://budi-luhur-app3.vercel.app"
