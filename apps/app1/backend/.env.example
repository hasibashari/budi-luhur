PORT=4001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@neon-host/fe_tablet_app1?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration (Khusus App 1)
# Kredensial ini hanya digunakan di Backend dan tidak terekspos ke frontend
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Nilai default: gemini-2.5-flash. Opsi model lain: gemini-1.5-flash, gemini-1.5-pro, gemini-2.5-pro

NODE_ENV=development

VAPID_SUBJECT="mailto:admin@budiluhur.ac.id"
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
