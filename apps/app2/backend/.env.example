# Pilluna Backend Environment Configuration (Template)
# Copy this file to .env and adjust the values accordingly.

# Server Port
PORT=4002

# Allowed CORS Origin for web frontend
CORS_ORIGIN=http://localhost:5174

# Database Connection (Neon PostgreSQL 15+)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
APP2_DATABASE_URL=postgresql://user:password@localhost:5432/fe_tablet_app2
DATABASE_URL=postgresql://user:password@localhost:5432/fe_tablet_app2

# JWT Authentication Secret (Must be >= 32 characters in production)
APP2_JWT_SECRET=your-minimum-32-character-secret-key-here-for-app2
JWT_SECRET=your-minimum-32-character-secret-key-here-for-app2
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@pilluna.id
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

