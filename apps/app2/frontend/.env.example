# Pilluna Frontend Environment Configuration (Template)
# Copy this file to .env and adjust the values accordingly.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:4002/api/v1

# Base URL Path
VITE_BASE_PATH=/app2/

# Isolated LocalStorage Session Keys
VITE_AUTH_STORAGE_KEY=app2_auth_token
VITE_USER_STORAGE_KEY=app2_auth_user

