# Server & Network
PORT=4003
CORS_ORIGIN=http://localhost:5175
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/app3_db

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Web Push Notifications (VAPID)
VAPID_SUBJECT="mailto:admin@budiluhur.ac.id"
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"

# S3 Object Storage (Neon Storage - Khusus App 3)
STORAGE_DRIVER=s3
AWS_ENDPOINT_URL_S3="https://your-neon-storage-endpoint"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION=us-east-2
AWS_S3_BUCKET=app3-storage
