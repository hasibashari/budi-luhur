{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "services": {
    "portal": {
      "root": "frontend",
      "framework": "vite"
    },
    "app1-frontend": {
      "root": "apps/app1/frontend",
      "framework": "vite"
    },
    "app1-backend": {
      "root": "apps/app1/backend",
      "framework": "express"
    },
    "app2-frontend": {
      "root": "apps/app2/frontend",
      "framework": "vite"
    },
    "app2-backend": {
      "root": "apps/app2/backend",
      "framework": "express"
    },
    "app3-frontend": {
      "root": "apps/app3/frontend",
      "framework": "vite"
    },
    "app3-backend": {
      "root": "apps/app3/backend",
      "framework": "express"
    },
    "template-backend": {
      "root": "apps/template-backend",
      "framework": "express"
    },
    "template-frontend": {
      "root": "apps/template-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/app1/(.*)",
      "destination": {
        "service": "app1-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/api/app2/(.*)",
      "destination": {
        "service": "app2-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/api/app3/(.*)",
      "destination": {
        "service": "app3-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/app1/(.*)",
      "destination": {
        "service": "app1-frontend"
      }
    },
    {
      "source": "/app1",
      "destination": {
        "service": "app1-frontend"
      }
    },
    {
      "source": "/app2/(.*)",
      "destination": {
        "service": "app2-frontend"
      }
    },
    {
      "source": "/app2",
      "destination": {
        "service": "app2-frontend"
      }
    },
    {
      "source": "/app3/(.*)",
      "destination": {
        "service": "app3-frontend"
      }
    },
    {
      "source": "/app3",
      "destination": {
        "service": "app3-frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portal"
      }
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}