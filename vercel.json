{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": "frontend",
      "framework": "vite"
    },
    "femory-frontend": {
      "root": "apps/app1/frontend",
      "framework": "vite"
    },
    "femory-backend": {
      "root": "apps/app1/backend",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "pilluna-frontend": {
      "root": "apps/app2/frontend",
      "framework": "vite"
    },
    "pilluna-backend": {
      "root": "apps/app2/backend",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "preluna-frontend": {
      "root": "apps/app3/frontend",
      "framework": "vite"
    },
    "preluna-backend": {
      "root": "apps/app3/backend",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "template-backend": {
      "root": "apps/template-backend",
      "framework": "express",
      "entrypoint": "src/server.ts"
    },
    "template-frontend": {
      "root": "apps/template-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/app1/(.*)",
      "destination": {
        "service": "femory-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/api/app2/(.*)",
      "destination": {
        "service": "pilluna-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/api/app3/(.*)",
      "destination": {
        "service": "preluna-backend",
        "path": "/$1"
      }
    },
    {
      "source": "/app1/assets/(.*)",
      "destination": {
        "service": "femory-frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/app1/(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "femory-frontend",
        "path": "/$1"
      }
    },
    {
      "source": "/app1",
      "destination": {
        "service": "femory-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/app1/(.*)",
      "destination": {
        "service": "femory-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/app2/assets/(.*)",
      "destination": {
        "service": "pilluna-frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/app2/(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "pilluna-frontend",
        "path": "/$1"
      }
    },
    {
      "source": "/app2",
      "destination": {
        "service": "pilluna-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/app2/(.*)",
      "destination": {
        "service": "pilluna-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/app3/assets/(.*)",
      "destination": {
        "service": "preluna-frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/app3/(.*\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "preluna-frontend",
        "path": "/$1"
      }
    },
    {
      "source": "/app3",
      "destination": {
        "service": "preluna-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/app3/(.*)",
      "destination": {
        "service": "preluna-frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portal"
      }
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}